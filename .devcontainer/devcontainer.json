{
  "name": "dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "./features/git-platform-clis": {
      "gh_version": "latest",
      "glab_version": "latest",
      "gitea_version": "latest",
      "install_hub": false,
      "install_bb": false,
      "install_forgejo_cli": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "./features/git-filter-repo": {
      "version": "2.47.0"
    },
    "./features/gitr": {
      "version": "latest"
    },
    "./features/dotdrop": {
      "version": "latest"
    },
    "./features/incus": {
      "version": "latest",
      "remote": "",
      "remote_url": ""
    }
  },
  "remoteEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "GH_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "GITLAB_TOKEN": "${localEnv:GITLAB_TOKEN}",
    "INCUS_REMOTE": "${localEnv:INCUS_REMOTE}",
    "INCUS_REMOTE_URL": "${localEnv:INCUS_REMOTE_URL}",
    "INCUS_CLIENT_CERT": "${localEnv:INCUS_CLIENT_CERT}",
    "INCUS_CLIENT_KEY": "${localEnv:INCUS_CLIENT_KEY}",
    "SYNC_IN_SERVER_URL": "http://localhost:3284",
    "SYNC_IN_ADMIN_TOKEN": "${localEnv:SYNC_IN_ADMIN_TOKEN}",
    "ONA_TOKEN": "${localEnv:ONA_TOKEN}",
    "ONA_API": "${localEnv:ONA_API}",
    "ONA_MCP_URL": "http://localhost:8788/sse"
  }
}
