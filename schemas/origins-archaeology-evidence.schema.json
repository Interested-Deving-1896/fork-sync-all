{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Interested-Deving-1896/fork-sync-all/blob/main/schemas/origins-archaeology-evidence.schema.json",
  "title": "Fork-Sync-All Origins and Code Archaeology evidence package",
  "type": "object",
  "required": ["schema_version", "contract", "package_id", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "fork-sync-all.origins-archaeology" },
    "package_id": { "type": "string", "minLength": 1 },
    "collector": { "type": "object", "properties": {
      "name": { "type": "string" }, "version": { "type": "string" },
      "provider": { "type": "string" }, "observed_at": { "type": "string", "format": "date-time" }
    }, "additionalProperties": true },
    "observations": { "type": "array", "items": {
      "type": "object",
      "required": ["source_repository", "target_repository", "evidence_kind", "locator"],
      "properties": {
        "observation_id": { "type": "string" },
        "source_repository": { "type": "string", "minLength": 1 },
        "target_repository": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["fork", "derived-from", "vendored", "copied-from", "inspired-by", "depends-on", "mirror-of", "extracted-logic", "reference", "schema-adopted", "pattern-adopted", "unknown"] },
        "source_revision": { "type": ["string", "null"] },
        "target_revision": { "type": ["string", "null"] },
        "evidence_kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "blob_oid": { "type": "string" },
        "source_paths": { "type": "array", "items": { "type": "string" } },
        "target_paths": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "rationale": { "type": "string" },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "coverage": { "type": "object", "properties": {
          "complete": { "type": "boolean" },
          "pagination_complete": { "type": "boolean" },
          "shallow_or_missing_objects": { "type": "boolean" },
          "permission_gaps": { "type": "array", "items": { "type": "string" } }
        }, "additionalProperties": true },
        "license_review": { "type": "string" }
      }, "additionalProperties": true
    }}
  }, "additionalProperties": true
}
