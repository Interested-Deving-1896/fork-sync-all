{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Interested-Deving-1896/fork-sync-all/blob/main/schemas/origins-agent-preflight-v1.schema.json",
  "title": "Origins-first Agent Preflight v1",
  "description": "Provider-neutral, read-only request and response contract. This contract never grants mutation authority.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "request_id", "task", "target", "limits"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "preflight_request" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "session_id": { "type": "string", "maxLength": 128 },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intent"],
          "properties": {
            "intent": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "scope": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "maxItems": 100 },
            "requested_depth": { "enum": ["minimal", "standard", "deep"] }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "revision": { "type": "string", "maxLength": 128 },
            "paths": { "type": "array", "items": { "type": "string", "maxLength": 1024 }, "maxItems": 500 }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "maxLength": 128 },
            "agent_id": { "type": "string", "maxLength": 128 },
            "model_id": { "type": "string", "maxLength": 256 },
            "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 100 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_context_bytes"],
          "properties": {
            "max_context_bytes": { "type": "integer", "minimum": 256, "maximum": 2000000 },
            "max_estimated_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "max_model_cost_usd": { "type": "number", "minimum": 0 },
            "allow_network_reads": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "status", "source", "locator"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "enum": ["provenance", "repository_origin", "code_archaeology", "linkage", "topology", "other"] },
        "status": { "enum": ["declared", "observed", "inferred", "human_approved", "contradicted", "stale", "incomplete", "inaccessible", "unknown"] },
        "source": { "type": "string", "maxLength": 1024 },
        "revision": { "type": "string", "maxLength": 128 },
        "locator": { "type": "string", "maxLength": 2048 },
        "summary": { "type": "string", "maxLength": 4000 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "request_id", "status", "target", "coverage", "evidence", "context", "budget", "authority"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "preflight_response" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["complete", "partial", "unavailable", "invalid_request"] },
        "target": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string" },
            "revision": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "required": ["state", "sources_checked", "unknowns"],
          "properties": {
            "state": { "enum": ["complete", "partial", "none"] },
            "sources_checked": { "type": "array", "items": { "type": "string" } },
            "unknowns": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "maxItems": 1000 },
        "context": {
          "type": "object",
          "required": ["text", "bytes", "estimated_tokens", "token_estimate_method", "omitted_evidence_ids"],
          "properties": {
            "text": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 0 },
            "estimated_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "token_estimate_method": { "enum": ["exact_tokenizer", "conservative_heuristic", "unknown"] },
            "omitted_evidence_ids": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["decision", "reason", "estimated_cost_usd", "actual_usage_known"],
          "properties": {
            "decision": { "enum": ["deterministic_only", "model_call_permitted", "use_lower_cost_model", "defer", "stop_for_approval", "unknown"] },
            "reason": { "type": "string", "maxLength": 2000 },
            "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
            "actual_usage_known": { "const": false },
            "authority_ref": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "recommendations": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
        "unresolved_questions": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
        "authority": {
          "type": "object",
          "required": ["provenance_owner", "read_only", "mutation_authorized", "human_review_required"],
          "properties": {
            "provenance_owner": { "const": "origins" },
            "read_only": { "const": true },
            "mutation_authorized": { "const": false },
            "human_review_required": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
